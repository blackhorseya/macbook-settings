# tool aliases
alias cat=bat
alias nano=vim
alias tf=terraform
alias tg=terragrunt
alias docker=podman
alias goland=/usr/local/bin/goland

# quick open rc
alias vimrc='${=EDITOR} ~/.vimrc'
alias myclirc='${=EDITOR} ~/.myclirc'

# git
alias gup='gpr && gfa && gbda'
alias commit='codegpt commit'

# openapi-generator-cli
alias openapi-generator-cli='docker run --rm \
                            -v "$PWD:$PWD" \
                            -w="$PWD" \
                            openapitools/openapi-generator-cli'

